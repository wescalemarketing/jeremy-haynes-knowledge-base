{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source record",
  "type": "object",
  "required": [
    "id",
    "url",
    "title",
    "kind",
    "published_date",
    "observed_date",
    "availability",
    "processing_state",
    "confidence",
    "locator",
    "rights",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^src_[a-f0-9]{16}$"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "blog",
        "skill",
        "podcast",
        "official_site",
        "youtube_video",
        "case_study",
        "youtube_channel",
        "interview",
        "appearance",
        "catalog",
        "pdf"
      ]
    },
    "published_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "observed_date": {
      "type": "string",
      "format": "date"
    },
    "availability": {
      "enum": [
        "public_page",
        "public_metadata_gated_body",
        "fetch_failed",
        "unknown",
        "search_result_only"
      ]
    },
    "processing_state": {
      "enum": [
        "discovered",
        "metadata_reviewed",
        "extracted",
        "verified",
        "excluded"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "rights": {
      "type": "string"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "official": {
      "type": "boolean"
    },
    "transcript_state": {
      "type": "string"
    },
    "timestamp_state": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
